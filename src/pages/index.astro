---
import logo from "../assets/logo.webp";

import Layout from "@layouts/Layout.astro";
---

<Layout title="Seoforma - Servicios de Creación Web">
  <div class="min-h-screen flex flex-col">
    <!-- Hero Section -->
    <section class="flex-1 flex items-center justify-center px-6 py-20">
      <div class="max-w-4xl mx-auto text-center">
        <div class="mb-8">
          <img
            src={logo.src}
            alt="Seoforma"
            class="w-20 h-20 mx-auto mb-6 rounded-full"
          />
        </div>
        <h1 class="text-5xl md:text-7xl font-light mb-6">
          Creamos experiencias
          <span class="block font-normal bg-gradient-to-r from-blue-400 via-cyan-300 to-teal-400 bg-clip-text text-transparent">digitales únicas</span>
        </h1>
        <p class="text-xl md:text-2xl text-slate-300 mb-12 font-light max-w-2xl mx-auto">
          Transformamos ideas en sitios web que conectan con tu audiencia
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#servicios"
            class="px-8 py-4 bg-gradient-to-r from-blue-500 to-cyan-500 text-white font-medium hover:from-blue-600 hover:to-cyan-600 transition-all duration-300 shadow-lg"
          >
            Ver servicios
          </a>
          <a
            href="#contacto"
            class="px-8 py-4 border border-cyan-400 text-cyan-400 hover:bg-cyan-400 hover:text-slate-900 transition-colors"
          >
            Contactar
          </a>
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section id="nosotros" class="py-20 px-6">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-light mb-6">
            <span class="bg-gradient-to-r from-blue-400 to-cyan-400 bg-clip-text text-transparent">Quiénes somos</span>
          </h2>
          <div class="w-20 h-px bg-gradient-to-r from-blue-400 to-cyan-400 mx-auto"></div>
        </div>
        <div class="grid md:grid-cols-2 gap-16 text-lg leading-relaxed">
          <div class="space-y-6">
            <p class="text-slate-300">
              Somos un equipo joven y apasionado de Mieres, Asturias, especializado en transformar ideas en experiencias digitales memorables.
            </p>
            <p class="text-slate-300">
              Formado por estudiantes de ADE y Programación Informática de la Universidad de Oviedo, combinamos visión empresarial con excelencia técnica.
            </p>
          </div>
          <div class="space-y-6">
            <p class="text-slate-300">
              Creemos que cada negocio tiene una historia única que contar. Nuestro enfoque es crear soluciones web personalizadas que reflejen la esencia de tu marca.
            </p>
            <p class="text-slate-300">
              Desde Asturias para el mundo, trabajamos contigo para llevar tu presencia digital al siguiente nivel.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section id="servicios" class="py-20 px-6 bg-slate-800/30 backdrop-blur-sm">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-light mb-6">
            <span class="bg-gradient-to-r from-blue-400 to-cyan-400 bg-clip-text text-transparent">Nuestros servicios</span>
          </h2>
          <div class="w-20 h-px bg-gradient-to-r from-blue-400 to-cyan-400 mx-auto"></div>
        </div>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="text-center p-8">
            <div class="w-16 h-16 mx-auto mb-6 bg-gradient-to-br from-blue-500/20 to-cyan-500/20 rounded-full flex items-center justify-center border border-cyan-400/30">
              <svg class="w-8 h-8 text-cyan-400" fill="currentColor" viewBox="0 0 24 24">
                <path d="M3 3h18v18H3V3zm16 16V5H5v14h14zM7 7h10v2H7V7zm0 4h10v2H7v-2zm0 4h7v2H7v-2z"/>
              </svg>
            </div>
            <h3 class="text-xl font-medium mb-4 text-white">Diseño Web</h3>
            <p class="text-slate-300 leading-relaxed">
              Creamos interfaces elegantes y funcionales que transmiten la esencia de tu marca
            </p>
          </div>
          <div class="text-center p-8">
            <div class="w-16 h-16 mx-auto mb-6 bg-gradient-to-br from-blue-500/20 to-cyan-500/20 rounded-full flex items-center justify-center border border-cyan-400/30">
              <svg class="w-8 h-8 text-cyan-400" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
              </svg>
            </div>
            <h3 class="text-xl font-medium mb-4 text-white">Desarrollo</h3>
            <p class="text-slate-300 leading-relaxed">
              Desarrollamos sitios web rápidos, seguros y optimizados para todos los dispositivos
            </p>
          </div>
          <div class="text-center p-8">
            <div class="w-16 h-16 mx-auto mb-6 bg-gradient-to-br from-blue-500/20 to-cyan-500/20 rounded-full flex items-center justify-center border border-cyan-400/30">
              <svg class="w-8 h-8 text-cyan-400" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
              </svg>
            </div>
            <h3 class="text-xl font-medium mb-4 text-white">Optimización</h3>
            <p class="text-slate-300 leading-relaxed">
              Mejoramos el rendimiento y posicionamiento SEO para maximizar tu alcance digital
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contacto" class="py-20 px-6">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-4xl md:text-5xl font-light mb-6">
          <span class="bg-gradient-to-r from-blue-400 to-cyan-400 bg-clip-text text-transparent">¿Hablamos?</span>
        </h2>
        <div class="w-20 h-px bg-gradient-to-r from-blue-400 to-cyan-400 mx-auto mb-8"></div>
        <p class="text-xl text-slate-300 mb-12 max-w-2xl mx-auto">
          Estamos listos para transformar tu idea en una experiencia digital memorable
        </p>
        <a
          href="/contact-us"
          class="inline-block px-8 py-4 bg-gradient-to-r from-blue-500 to-cyan-500 text-white font-medium hover:from-blue-600 hover:to-cyan-600 transition-all duration-300 shadow-lg"
        >
          Iniciar proyecto
        </a>
      </div>
    </section>
  </div>

</Layout>

<script>
  // Smooth scroll for navigation links
  document.addEventListener("astro:page-load", () => {
    const links = document.querySelectorAll('a[href^="#"]');
    
    links.forEach(link => {
      link.addEventListener("click", function (e) {
        e.preventDefault();
        const targetId = this.getAttribute("href").substring(1);
        const targetSection = document.getElementById(targetId);
        const header = document.querySelector("header");
        
        if (targetSection && header) {
          window.scrollTo({
            top: targetSection.offsetTop - header.offsetHeight - 20,
            behavior: "smooth",
          });
        }
      });
    });
  });
</script>
